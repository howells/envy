{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@howells/typescript-config/tsc-no-dom-library-monorepo",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "paths": {
      "@howells/envy/adapters/vercel": ["../../core/src/adapters/vercel"]
