{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@howells/typescript-config/tsc-no-dom-library-monorepo",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "paths": {
      "@howells/envy": ["../core/src/index"],
      "@howells/envy/next": ["../core/src/next"]
    },
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
