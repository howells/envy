{
  "name": "@howells/envy",
  "version": "0.3.6",
  "type": "module",
  "bin": {
    "envy": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./src/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./dotenv": {
      "types": "./dist/dotenv.d.ts",
      "import": "./dist/dotenv.js",
      "require": "./dist/dotenv.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "import": "./dist/lint.js",
      "require": "./dist/lint.cjs"
    },
    "./adapters/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "import": "./dist/adapters/vercel.js",
      "require": "./dist/adapters/vercel.cjs"
    },
    "./adapters/railway": {
      "types": "./dist/adapters/railway.d.ts",
      "import": "./dist/adapters/railway.js",
      "require": "./dist/adapters/railway.cjs"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "src/cli.d.ts",
    "src/cli.ts",
    "src/index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/dotenv.ts src/next.ts src/lint.ts src/adapters/vercel.ts src/adapters/railway.ts --format esm,cjs --dts --clean --sourcemap && tsup src/cli.ts --format esm --no-config --clean=false --sourcemap",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "zod": "^4.3.6"
  },
  "description": "Zod-powered environment parsing for TypeScript applications.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/envy.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/howells/envy/issues"
  },
  "homepage": "https://github.com/howells/envy#readme"
}
